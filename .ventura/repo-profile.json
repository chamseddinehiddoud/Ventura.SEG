{
  "schema_version": 1,
  "repository_role": "security",
  "autonomy": "guarded",
  "budget_profile": "critical",
  "context": {"strategy": "semantic_ast", "max_files": 20, "max_chars": 32000},
  "routing": {"enabled": true, "champion_challenger": true},
  "validation": {"required": ["security-tests", "codeql", "autonomy-gate", "security-baseline"]},
  "security": {"hard_gates": ["delete_repository", "force_push", "change_secrets", "reduce_security", "destructive_deployment", "budget_override", "irreversible_financial_action"]}
}
